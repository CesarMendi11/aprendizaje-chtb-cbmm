# =========================
# ERP - CREDENTIALS
# =========================
# La URL del ERP NO se obtiene actualmente del .env.
# Está configurada en configs/cbmm.yaml -> erp.base_url.
ERP_USERNAME=<ERP_USERNAME>
ERP_PASSWORD=<ERP_PASSWORD>

# =========================
# API
# =========================
API_HOST=127.0.0.1
API_PORT=8000
# 1 = recarga automática de Uvicorn en desarrollo; 0 = ejecución estable.
API_RELOAD=0
# Orígenes permitidos por CORS para clientes web.
API_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200


# =========================
# API - FEATURES / ADMIN
# =========================
# Activa las APIs administrativas/gobernadas.
ERP_ASSISTANT_SEMANTIC_REVIEW_API=1
# 0 = Admin API solamente accesible desde loopback.
# 1 = permite acceso remoto; no agrega autenticación ni RBAC.
ERP_ASSISTANT_SEMANTIC_REVIEW_ALLOW_REMOTE=0



# =========================
# CRAWLER / PIPELINE
# =========================
ERP_ASSISTANT_CRAWL_PROFILE=configs/cbmm.yaml
# Directorio raíz para ejecuciones aisladas del pipeline.
ERP_ASSISTANT_PIPELINE_RUNS_DIR=data/runs/pipeline


# =========================
# POSTGRESQL
# =========================
# Puerto, base y usuario deben coincidir con ERP_ASSISTANT_DATABASE_URL.
ERP_ASSISTANT_POSTGRES_PORT=5434
ERP_ASSISTANT_POSTGRES_DB=erp_assistant
# Usuario con el que Docker inicializa PostgreSQL.
ERP_ASSISTANT_POSTGRES_USER=erp_assistant
# Usado por docker-compose.postgres.yml.
ERP_ASSISTANT_POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
# URL utilizada por SQLAlchemy/psycopg en el backend.
ERP_ASSISTANT_DATABASE_URL=postgresql+psycopg://erp_assistant:<POSTGRES_PASSWORD>@127.0.0.1:5434/erp_assistant

ERP_ASSISTANT_DATABASE_ECHO=false
ERP_ASSISTANT_DATABASE_POOL_SIZE=5
ERP_ASSISTANT_DATABASE_MAX_OVERFLOW=5
# Crea SyncJobs asociados a operaciones de publicación/proyección.
ERP_ASSISTANT_CREATE_SYNC_JOBS=true


# =========================
# CHROMADB
# =========================
# Ruta usada tanto por la proyección estructural como semántica.
ERP_ASSISTANT_CHROMA_PATH=data/vectorstore/chroma


# =========================
# NEO4J
# =========================
# Puertos publicados por Docker en la laptop.
ERP_ASSISTANT_NEO4J_HTTP_PORT=7474
ERP_ASSISTANT_NEO4J_BOLT_PORT=7687
# URI utilizada por el backend Python. El puerto debe coincidir con
# ERP_ASSISTANT_NEO4J_BOLT_PORT cuando Neo4j corre en este Docker local.
ERP_ASSISTANT_NEO4J_URI=bolt://127.0.0.1:7687
ERP_ASSISTANT_NEO4J_USER=neo4j
ERP_ASSISTANT_NEO4J_DATABASE=neo4j
ERP_ASSISTANT_NEO4J_PASSWORD=<NEO4J_PASSWORD>


# =========================
# OLLAMA
# =========================
ERP_ASSISTANT_OLLAMA_URL=<OLLAMA_URL>
# Embeddings usados por Structural Chroma y Semantic Chroma.
ERP_ASSISTANT_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Modelo usado para generación semántica estructurada (M2).
ERP_ASSISTANT_GENERATION_MODEL=llama3.2:3b
# Timeout HTTP base para Ollama, en segundos.
ERP_ASSISTANT_OLLAMA_TIMEOUT=30
# Writer grounded de respuestas finales (M3), seleccionado en DEVELOPMENT.
ERP_ASSISTANT_WRITER_MODEL=qwen3.5:4b
ERP_ASSISTANT_WRITER_TIMEOUT=60
# Timeout para generación estructurada/semántica con Ollama.
ERP_ASSISTANT_OLLAMA_STRUCTURED_TIMEOUT=120
# Cantidad máxima de textos procesados por lote de embeddings.
ERP_ASSISTANT_EMBEDDING_BATCH_SIZE=32


# ============================================================
# TESTS DE INTEGRACIÓN - OPCIONALES
# ============================================================
# Dejarlos vacíos hace que las pruebas que requieren infraestructura
# de integración se salten.
#
# IMPORTANTE:
# TEST_DATABASE_URL debe apuntar a una base DE PRUEBAS separada.
# Algunas pruebas exigen que el nombre contenga "semantic_test".
# Nunca apuntar estos tests a la base gobernada/ACTIVE real.
TEST_DATABASE_URL=

TEST_NEO4J_URI=
TEST_NEO4J_USER=
TEST_NEO4J_PASSWORD=
TEST_NEO4J_DATABASE=
